# 复制成 .env，修改为你自己的密码；不要提交 .env。
HOME_STORAGE_PASSWORD=
HOME_STORAGE_PORT=8080
APP_TIMEZONE=Asia/Shanghai
# 填写 NAS 上拥有 data 目录读写权限的用户/组编号（id -u / id -g）。
PUID=1000
PGID=1000
# updater 的 APP_UID/APP_GID 会使用同一组 PUID/PGID；不要另行填写。
# 程序版本来自镜像，勿在此配置 HOMESTORAGE_VERSION/HOMESTORAGE_REVISION。
# 公开仓库不需要；私有仓库可用仅 Adventurer0/HomeStorage 的 Contents:read token。
# 只交给更新服务，不给网页/AI；填写后不要提交此文件。
UPDATE_GITHUB_TOKEN=

# 推荐登录网页「设置 → AI 与语音」配置，保存立即生效。
# 以下仅用于兼容旧部署；首次网页保存后以网页配置为准。
# API 密钥只保存在 NAS 后端，不要提交到 GitHub。
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# 录音转文字需服务商支持 transcription API；不填则保留文字聊天。
AI_TRANSCRIPTION_MODEL=
AI_TRANSCRIPTION_BASE_URL=
AI_TRANSCRIPTION_API_KEY=
